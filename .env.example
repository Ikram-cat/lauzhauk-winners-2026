# Frontend build input. Public value for local development.
API_BASE_URL=http://localhost:8080

# Backend local port. Railway supplies the service port at runtime.
PORT=8080

# Backend. Set to the actual, comma-separated browser origins.
CORS_ALLOWED_ORIGINS=

# Backend realtime (GTFS-RT TripUpdates, opentransportdata.swiss). Put the key in .env, never in Git.
GTFS_RT_API_KEY=

# Backend disruption duration (analytics/sbb_duration outputs, local only).
DURATION_ARTIFACT_PATH=
DISRUPTION_TIMELINES_DIR=
